# --- Master switch: live execution is OFF unless explicitly enabled ---
LIVE_TRADING_ENABLED=false

# --- Exchanges (ccxt ids) ---
SPOT_EXCHANGES=kraken,binance
PERP_EXCHANGES=bybit,deribit

# --- Strategy sizing (quote currency per leg) ---
TARGET_QUOTE_SIZES=100,500,1000
MIN_NET_PROFIT_USD=5
SLIPPAGE_BUFFER_BPS=5
LIQUIDITY_HAIRCUT=0.50

# --- Fees (worst case: taker on every leg, entry and exit) ---
DEFAULT_TAKER_FEE_BPS=10

# --- Staleness gate (funding-rate data) ---
MAX_DATA_AGE_MS_FUNDING=2000

# --- Execution / legging risk ---
MAX_LEG_DELAY_MS=1500
DRY_RUN_LATENCY_MS=150

# --- Perp risk ---
MAX_LEVERAGE=2
LIQUIDATION_BUFFER_PCT=15

# --- Circuit breaker ---
MAX_DAILY_LOSS_EUR=25
CB_MAX_CONSECUTIVE_FAILURES=3
CB_MAX_ORDERS_PER_WINDOW=5
CB_ORDER_WINDOW_SECONDS=60

# --- Storage ---
SQLITE_URL=sqlite+aiosqlite:///./arb_state.db
DUCKDB_PATH=./arb_ticks.duckdb

# --- Paper trading ---
PAPER_START_BALANCE_EUR=10000

# --- Telegram alerts (optional, free) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
