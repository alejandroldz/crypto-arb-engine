# --- Master switch: live execution is OFF unless explicitly enabled ---
LIVE_TRADING_ENABLED=false

# --- Exchanges (ccxt ids) ---
SPOT_EXCHANGES=kraken
SPOT_SYMBOLS=BTC/USD,ETH/USD,SOL/USD
PERP_EXCHANGES=krakenfutures,okx
PERP_SYMBOL_MAP=krakenfutures:BTC/USD:USD,ETH/USD:USD;okx:BTC/USD:USD-310404,ETH/USD:USD-310404,SOL/USD:USD-310404

# --- Strategy sizing (quote currency per leg) ---
TARGET_QUOTE_SIZES=100,500,1000
MIN_NET_PROFIT_USD=5
SLIPPAGE_BUFFER_BPS=5
LIQUIDITY_HAIRCUT=0.50

# --- Fees (worst case: taker on every leg, entry and exit; per venue) ---
TAKER_FEE_BPS=kraken:40,krakenfutures:5,okx:5
DEFAULT_TAKER_FEE_BPS=40
MIN_FUNDING_HISTORY=30

# --- Staleness gate (funding-rate data) ---
MAX_DATA_AGE_MS_FUNDING=2000

# --- Execution / legging risk ---
MAX_LEG_DELAY_MS=1500
DRY_RUN_LATENCY_MS=150

# --- Perp risk ---
MAX_LEVERAGE=10
# short-leg leverage per venue (kraken unified multi-collateral 5x, okx USD-only 1x)
SHORT_LEVERAGE_MAP=krakenfutures:5,okx:1
LIQUIDATION_BUFFER_PCT=15

# --- Circuit breaker ---
MAX_DAILY_LOSS_USD=25
CB_MAX_CONSECUTIVE_FAILURES=3
CB_MAX_ORDERS_PER_WINDOW=5
CB_ORDER_WINDOW_SECONDS=60

# --- Storage ---
SQLITE_URL=sqlite+aiosqlite:///./arb_state.db
DUCKDB_PATH=./arb_ticks.duckdb

# --- Paper trading ---
PAPER_START_BALANCE_USD=10000

# --- Telegram alerts (optional, free) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Unified Trading Account (cross-collateral) — paper simulation
ACCOUNT_MARGIN_MODE=UNIFIED
UTA_CAPITAL_UTILIZATION_PCT=0.90
COLLATERAL_HAIRCUT_MAP=BTC:0.95,ETH:0.95,SOL:0.85
MIN_COLLATERAL_RATIO_REQUIRED=0.80
MAX_ACCOUNT_MMR_WARNING=0.65
MAX_ACCOUNT_MMR_EMERGENCY_UNWIND=0.75
SIM_MAINTENANCE_MARGIN_RATE=0.25

# Optional read-only API keys for REAL account health (never trading keys)
KRAKENFUTURES_API_KEY=
KRAKENFUTURES_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
